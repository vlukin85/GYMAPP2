<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ironrise_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/ironrise_widget_background"
  android:padding="16dp">

  <TextView
    android:id="@+id/ironrise_widget_program"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#F6F0E6"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/ironrise_widget_exercise"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/ironrise_widget_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#B7B8BD"
    android:textSize="12sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/ironrise_widget_primary_action"
      android:layout_width="0dp"
      android:layout_height="42dp"
      android:layout_weight="1"
      android:background="@drawable/ironrise_widget_primary_action"
      android:gravity="center"
      android:textColor="#101217"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/ironrise_widget_secondary_action"
      android:layout_width="0dp"
      android:layout_height="42dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/ironrise_widget_secondary_action"
      android:gravity="center"
      android:textColor="#F6F0E6"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
