<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ironrise_week_stats_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="14dp"
  android:background="@drawable/ironrise_widget_background">

  <TextView
    android:id="@+id/ironrise_week_stats_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#FFFFFFFF"
    android:textSize="11sp"
    android:textStyle="bold"
    android:letterSpacing="0.08" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/ironrise_week_stats_workouts"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="#FFFFFFFF"
      android:textSize="18sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/ironrise_week_stats_days"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:textColor="#B8C4D8"
      android:textSize="12sp" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/ironrise_week_stats_progress"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="8dp"
    android:progressTint="#E53935"
    android:progressBackgroundTint="#42506A"
    android:max="7" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/ironrise_week_stats_volume"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="#B8C4D8"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/ironrise_week_stats_duration"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#B8C4D8"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
